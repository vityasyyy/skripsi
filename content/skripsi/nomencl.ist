%% 
%% 
%% Nomenclature style file for MAKEINDEX.
%% For nomencl v2.5 (and later)
%% 
%% Formats glossary entries to show, e.g. nomenclature of equations.
%% 
%% ---- for input file ----
keyword    "\\nomenclatureentry"
quote '%'
%% ---- for output file ----
%%
%% Local copy for this thesis build. The three lethead_* specifiers in the
%% distributed file are ignored by makeindex 2.18 and produce three benign
%% "Input style error" messages. The heading_* and headings_flag entries below
%% produce the same nomenclature grouping, so this copy changes no output.
%%
preamble   "\n\\begin{thenomenclature} \n"%
postamble  "\n\n\\end{thenomenclature}\n" group_skip "\n"
delim_0    ""
delim_1    ""
delim_2    ""
heading_prefix "\\nomgroup{"
heading_suffix "}"
headings_flag  1
line_max 1000

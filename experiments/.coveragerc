[run]
branch = True
source = experiments
# The offline suite imports the measured modules directly. Only the excluded
# historical mock analyzer and its generator remain outside the line gate: they
# use pandas/scipy/matplotlib and numpy, which are not part of the stdlib-only
# experiment runtime (analyze.py also refuses measured input).
omit =
    experiments/tests/*
    experiments/sensitivity/test_*.py
    experiments/analysis/analyze.py
    experiments/analysis/mockgen.py

[report]
fail_under = 100
exclude_lines =
    if __name__ == .__main__.:
    raise NotImplementedError
    pragma: no cover
